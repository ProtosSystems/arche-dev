NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXX
CLERK_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXX
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_DISABLED_FOR_DEV=false
NEXT_PUBLIC_AUTH_DISABLED_FOR_DEV=false
NEXT_PUBLIC_PORTAL_MOCK=true

# Paddle.js client-side token, used by the billing page to open the checkout
# overlay for a transaction Paddle redirects to ?_ptxn=. Sandbox tokens are
# prefixed test_, live tokens live_; the environment is derived from the prefix.
# This is publishable and safe in the browser -- never put a Paddle API key here.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_xxxxxxxxxxxxxxxxxxxxxxxxxx
